# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------
# postgres://, postgresql:// and ?sslmode=require URLs are accepted and converted automatically
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/shipora
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Shipora
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------
# Frontend URL (email links, Paystack redirects, Google sign-in redirect)
# ---------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:5173
# Extra allowed browser origins, comma separated (PUBLIC_BASE_URL is always allowed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shipora-one.vercel.app
# Optional regex for preview deployments, e.g. https://shipora-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# ---------------------------------------------------------------
# Redis — use REDIS_URL for managed Redis (password / TLS), or host + port
# ---------------------------------------------------------------
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
# Keep users signed in from the signed JWT if Redis is briefly down
REDIS_FAIL_OPEN=true

# ---------------------------------------------------------------
# Payments (Paystack) — set the webhook URL in the Paystack dashboard to
#   https://<your-api>/api/v1.0/shipments/paystack/webhook
# ---------------------------------------------------------------
PAYSTACK_SECRET_KEY=

# ---------------------------------------------------------------
# KYC (QoreID) — keep these out of source control
# ---------------------------------------------------------------
KYC_PROVIDER_BASE_URL=https://api.qoreid.com
KYC_CLIENT_ID=
KYC_CLIENT_SECRET=
KYC_STRICT=false

# ---------------------------------------------------------------
# File storage (Cloudflare R2 / S3)
# ---------------------------------------------------------------
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=
BUCKET_NAME=
R2_PUBLIC_BASE_URL=
UPLOAD_MAX_MB=10

# ---------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
# Google OAuth callback if the API runs behind a proxy, e.g.
# https://api.example.com/api/v1.0/auth/google
GOOGLE_REDIRECT_URI=
SESSION_SECRET_KEY=
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
MAIL_VALIDATE_CERTS=true
MAIL_SUPPRESS_SEND=false
EMAIL_VERIFICATION_MAX_AGE_HOURS=72
PASSWORD_RESET_MAX_AGE_MINUTES=60
OpenRouteServiceKey=
