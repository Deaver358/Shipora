+        }
+        if self.PUBLIC_BASE_URL:
+            origins.add(self.PUBLIC_BASE_URL.strip().rstrip("/"))
+        return sorted(origins)
+
+    @property
+    def frontend_url(self) -> str:
+        return (self.PUBLIC_BASE_URL or "http://localhost:5173").rstrip("/")
+
